model Athlete {
  id        String    @id @default(uuid())
  firstName String
  lastName  String
  nickname  String
  bio       String
  socials   Social[]
  weightClass weightClass @relation(fields: [weightClassId], references: [id])
  weightClassId String
  organizations AthleteoOnOrganization[]
}

model AthleteoOnOrganization { 
    id String @id @default(uuid())
    athlete Athlete @relation(fields: [athleteId], references: [id])
    athleteId String
    organziation Organization @relation(fields: [organziationId], references: [id])
    organziationId String
}